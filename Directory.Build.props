<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- XML documentation discipline is written-as-you-go (coding-conventions § Documentation XML)
         and the whole repo builds at zero doc warnings — keep it that way by promoting them to
         errors: CS1591 missing doc, CS1573 partial params, CS1574 broken cref. Test projects are
         unaffected (they set GenerateDocumentationFile=false). -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;CS1574</WarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Package metadata -->
    <Authors>FRi</Authors>
    <Company>Stellaegis</Company>
    <Product>Stellaegis</Product>
    <Copyright>Copyright © Stellaegis 2026</Copyright>
    <PackageProjectUrl>https://github.com/Stellaegis/Stellaegis.Primitives</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Stellaegis/Stellaegis.Primitives</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Versioning -->
    <VersionPrefix>5.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">dev</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Package output -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
