<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Primitives.DependencyInjection</RootNamespace>
    <PackageId>Stellaegis.Primitives.DependencyInjection</PackageId>
    <Description>Stellaegis primitives for an application assembled by dependency injection, with or without ASP.NET Core: its frame declared once, what each module and its adapter declare, and the confrontation of the two at startup. No dependency beyond the dependency injection abstractions.</Description>
    <PackageTags>stellaegis;dependency-injection;compartment;modules</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <InternalsVisibleTo Include="Stellaegis.Primitives.Tests" />
    <ProjectReference Include="..\Stellaegis.Primitives\Stellaegis.Primitives.csproj" />
  </ItemGroup>

</Project>
