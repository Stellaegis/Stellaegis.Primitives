<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Primitives.Data</RootNamespace>
    <PackageId>Stellaegis.Primitives.Data</PackageId>
    <Description>Stellaegis data primitives for modules that use a database: unit of work per database, opened in a space for an actor that the database reads from its session context (SQL Server, PostgreSQL); the declaration of a module's database, its installation by an administrator and its verification by the application at startup; Dapper type handlers for the primitive types, and the patterns that go with them.</Description>
    <PackageTags>stellaegis;unit-of-work;ado-net;database</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <InternalsVisibleTo Include="Stellaegis.Primitives.Tests" />
    <ProjectReference Include="..\Stellaegis.Primitives\Stellaegis.Primitives.csproj" />
    <ProjectReference Include="..\Stellaegis.Primitives.Hosting\Stellaegis.Primitives.Hosting.csproj" />
  </ItemGroup>

</Project>
