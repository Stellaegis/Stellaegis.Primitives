<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Primitives.Hosting</RootNamespace>
    <PackageId>Stellaegis.Primitives.Hosting</PackageId>
    <Description>Stellaegis primitives for an application assembled by a host, with or without ASP.NET Core: its frame declared once, what each module and its adapter declare, their validation at startup, and the common forms of a module's options and HTTP client. No dependency beyond the Microsoft.Extensions abstractions of an assembled application.</Description>
    <PackageTags>stellaegis;hosting;dependency-injection;options;compartment;modules</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <InternalsVisibleTo Include="Stellaegis.Primitives.Tests" />
    <ProjectReference Include="..\Stellaegis.Primitives\Stellaegis.Primitives.csproj" />
  </ItemGroup>

</Project>
