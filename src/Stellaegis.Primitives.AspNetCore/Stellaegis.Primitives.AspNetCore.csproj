<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Primitives.AspNetCore</RootNamespace>
    <PackageId>Stellaegis.Primitives.AspNetCore</PackageId>
    <Description>Stellaegis primitives for modules that expose HTTP endpoints: the module a route belongs to, the request context port carrying the space and the actor of a request, the operations that describe routes and that an application secures them by, a startup check of their declarations, and the translation of errors to HTTP answers. No dependency beyond ASP.NET Core.</Description>
    <PackageTags>stellaegis;aspnetcore;minimal-api;compartment;authorization</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Stellaegis.Primitives.Tests" />
    <ProjectReference Include="..\Stellaegis.Primitives\Stellaegis.Primitives.csproj" />
    <ProjectReference Include="..\Stellaegis.Primitives.Hosting\Stellaegis.Primitives.Hosting.csproj" />
  </ItemGroup>

</Project>
