<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellaegis.Primitives.AspNetCore</RootNamespace>
    <PackageId>Stellaegis.Primitives.AspNetCore</PackageId>
    <Description>Stellaegis primitives for modules that expose HTTP endpoints: the request context port, carrying the compartment and the actor of a request. No dependency beyond ASP.NET Core.</Description>
    <PackageTags>stellaegis;aspnetcore;minimal-api;compartment</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Stellaegis.Primitives.Tests" />
    <ProjectReference Include="..\Stellaegis.Primitives\Stellaegis.Primitives.csproj" />
  </ItemGroup>

</Project>
